# Скопируй в .env и заполни
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TOKEN_HERE
STEAM_API_KEY=PASTE_YOUR_STEAM_API_KEY
# Опционально: Faceit Open API ключ (бесплатно на developers.faceit.com) — включит проверку Faceit по SteamID
# FACEIT_API_KEY=PASTE_YOUR_FACEIT_KEY
# Опционально: HTTP/SOCKS5 прокси, если api.telegram.org недоступен напрямую
# PROXY=socks5://user:pass@host:port